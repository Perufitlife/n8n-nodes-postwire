{
  "name": "n8n-nodes-postwire",
  "version": "0.3.0",
  "description": "Publish one idea natively to TikTok, Instagram, YouTube, LinkedIn, X, Bluesky, Mastodon, Telegram, Discord and Reddit from n8n — a different post written for each network, via PostWire.",
  "keywords": [
    "n8n-community-node-package",
    "postwire",
    "social media",
    "tiktok",
    "instagram",
    "youtube",
    "linkedin",
    "cross-posting",
    "scheduling"
  ],
  "license": "MIT",
  "homepage": "https://postwire.io",
  "author": {
    "name": "PostWire",
    "email": "privacy@postwire.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perufitlife/n8n-nodes-postwire.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test test/",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PostWireApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PostWire/PostWire.node.js"
    ],
    "strict": true
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.4",
    "n8n-workflow": "*",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "typescript": "^5.7.2"
  }
}
