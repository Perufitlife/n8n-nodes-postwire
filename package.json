{
  "name": "n8n-nodes-postwire",
  "version": "0.4.1",
  "description": "Publish one idea natively to TikTok, Instagram, YouTube, LinkedIn, Facebook, X, Bluesky, Mastodon, Telegram and Discord from n8n (a different post written for each network), and trigger workflows on signed PostWire webhooks: post published or failed, connection expired, approval requested or decided.",
  "keywords": [
    "n8n-community-node-package",
    "postwire",
    "social media",
    "tiktok",
    "instagram",
    "youtube",
    "linkedin",
    "x",
    "twitter",
    "cross-posting",
    "scheduling",
    "approval",
    "webhook",
    "trigger"
  ],
  "license": "MIT",
  "homepage": "https://postwire.io/n8n-social-media-automation/#official-n8n-node",
  "author": {
    "name": "PostWire",
    "email": "privacy@postwire.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perufitlife/n8n-nodes-postwire.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test test/*.test.js",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "scan:local": "node scripts/scan-local.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PostWireApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PostWire/PostWire.node.js",
      "dist/nodes/PostWireTrigger/PostWireTrigger.node.js"
    ],
    "strict": true
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.50.4",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.4",
    "n8n-workflow": "*",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "typescript": "^5.7.2"
  },
  "bugs": {
    "url": "https://github.com/Perufitlife/n8n-nodes-postwire/issues"
  }
}
